# MiM Essay CRM API
MIM_ESSAY_API_KEY=your-mim-essay-crm-api-key

# Bearer token that Claude.ai must send in Authorization header
# Generate a strong random secret: `openssl rand -hex 32`
MCP_BEARER_TOKEN=replace-with-random-secret

# Vercel KV / Upstash Redis — auto-populated by Vercel when you add the KV integration
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: secret used by Vercel Cron to authenticate refresh calls
# Vercel automatically adds Authorization: Bearer <CRON_SECRET> to cron requests
CRON_SECRET=replace-with-random-secret
