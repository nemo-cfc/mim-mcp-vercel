# =============================================================================
# MiM Essay CRM
# =============================================================================
MIM_ESSAY_API_KEY=your-mim-essay-crm-api-key

# =============================================================================
# MCP auth — bearer token Claude.ai (or curl) must send. Embedded in the URL
# as ?token=... when adding the connector in Claude.ai.
# Generate: `openssl rand -hex 32`
# =============================================================================
MCP_BEARER_TOKEN=replace-with-random-secret

# =============================================================================
# Webapp admin bootstrap. On first login attempt with these credentials and
# an empty user store, the admin record is automatically created in Redis.
# After that, manage users from /admin (or change ADMIN_PASSWORD here and the
# bootstrap path won't fire again — your existing admin keeps the original
# stored password until you reset it from /admin).
# =============================================================================
ADMIN_EMAIL=you@mim-essay.com
ADMIN_PASSWORD=change-me-on-first-login

# =============================================================================
# Vercel KV / Upstash Redis — auto-populated by Vercel when you connect the
# Upstash for Redis storage. Both prefixed and unprefixed names are read.
# =============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=

# =============================================================================
# Meta Ads — direct Graph API access (no longer routed through Pipeboard).
# Long-lived user token from https://developers.facebook.com/tools/debug/accesstoken/
# (or a system-user token from Business Settings — recommended for permanence)
# =============================================================================
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_509761434701737

# =============================================================================
# Google Ads — direct API access (no longer routed through Pipeboard).
# Setup steps for the OAuth refresh_token are in lib/google-ads.ts header
# and the project README. You'll need:
#   1. Developer token from your Google Ads account (API Center → Apply)
#   2. Google Cloud project with Google Ads API enabled
#   3. OAuth 2.0 desktop client (gives client_id + client_secret)
#   4. One-time OAuth flow with offline access scope to get refresh_token
# =============================================================================
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=9859642362
# Optional — only set if your account is accessed via a manager (MCC) account.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =============================================================================
# Pipeboard (legacy — kept for fallback only; no longer used by reports.ts)
# https://pipeboard.co
# =============================================================================
PIPEBOARD_TOKEN=pk_your_pipeboard_token_here

# =============================================================================
# Gemini — for AI-generated commentary in dashboard reports
# https://ai.google.dev/gemini-api/docs/api-key
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# Optional: cron auth secret (only used by the legacy /api/refresh endpoint).
# The dashboard tools no longer rely on a cron; this is kept for one-off
# bulk-cache refreshes if you want them.
# =============================================================================
CRON_SECRET=replace-with-random-secret
